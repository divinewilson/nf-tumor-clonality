/*
 * Tumor Clonality Pipeline Configuration
 */

params {
    // === Input/Output Parameters ===
    sample_id       = "00-010"
    projectDir      = "/home/pc/PROJECTS/CLONALITY_ANALYSIS/DATA"
    outdir          = "results/${params.sample_id}"
    
    // Input Files (Can use wildcards if needed later)
    cnv_files       = "${params.projectDir}/CN_DATA/${params.sample_id}*__cnvs.txt"
    vcf_files       = "${params.projectDir}/VCF_DATA/${params.sample_id}*_reformated.vcf"
    vcf_types       = "pcawg_consensus"  // or other types supported by parser
    goi_file        = "${params.projectDir}/gene_of_interest.txt"
    
    // Subsampling Parameters
    subsample_num   = 1000
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)' // Ensures output files belong to you, not root
}

process {
    container = 'divinwilson/nf_clonality:v1'
    cpus = 10
    memory = '15 GB'
    
    // Inject the Conda environment bin path into the container's PATH
    withName: 'GENERATE_PRIORITY_SSM|FORMAT_RESULTS|MAKE_CLONEVOL_INFILES' {
        containerOptions = '--env PATH=/opt/conda/envs/pybedtools/bin:$PATH'
    }
    
    withName: 'PREPARE_PHYLOWGS_INPUTS|RUN_MULTIEVOLVE|WRITE_RESULTS' {
        containerOptions = '--env PATH=/opt/conda/envs/PhyloWGS/bin:$PATH'
    }
    
    withName: 'CLONEVOL' {
        containerOptions = '--env PATH=/opt/conda/envs/ClonEvol/bin:$PATH'
    }
}

